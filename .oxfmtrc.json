{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 80,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "src/components/ui/**",
    ".wrangler/**",
    "dist/**",
    ".cta.json",
    "**/*.md"
  ]
}
